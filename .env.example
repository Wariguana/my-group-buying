POSTGRES_DB=my_group_buying_dev
POSTGRES_USER=group_buying
POSTGRES_PASSWORD=local-development-only-password

# Next.js sets NODE_ENV automatically for dev/build/start. Production must run
# with NODE_ENV=production; do not put production secrets in this tracked file.
# NODE_ENV=development

# Required by Prisma and the application server. Replace this development-only
# example through the deployment platform's secret/environment configuration.
DATABASE_URL=postgresql://group_buying:local-development-only-password@localhost:5433/my_group_buying_dev

# ECPay convenience-store map and authoritative store-list verification.
APP_BASE_URL=http://localhost:3000
ECPAY_LOGISTICS_ENVIRONMENT=stage
ECPAY_LOGISTICS_MERCHANT_ID=0000000
ECPAY_LOGISTICS_HASH_KEY=replaceHashKey
ECPAY_LOGISTICS_HASH_IV=replaceHashIv
