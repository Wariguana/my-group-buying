{
  "name": "my-group-buying",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "admin:create:dev": "node --conditions=react-server --import tsx scripts/create-first-admin.ts",
    "admin:create:production": "node --conditions=react-server --import tsx scripts/create-first-admin-production.ts",
    "db:backup": "node --import tsx scripts/backup-postgres.ts",
    "db:backup:verify": "node --import tsx scripts/verify-postgres-backup.ts",
    "lint": "eslint",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration:bootstrap": "vitest run tests/integration/bootstrap-concurrency.test.ts",
    "test:integration:auth": "node --import tsx scripts/run-auth-integration.ts",
    "test:integration:orders": "node --import tsx scripts/run-order-integration.ts",
    "test:watch": "vitest",
    "test:e2e": "node --import tsx scripts/run-e2e.ts",
    "test:e2e:playwright": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "sku:backfill": "node --conditions=react-server --import tsx scripts/backfill-product-skus.ts",
    "prepare": "husky",
    "notifications:run": "node --conditions=react-server --import tsx scripts/run-notifications.ts",
    "preflight": "node --import tsx scripts/preflight.ts",
    "worker": "node --conditions=react-server --import tsx scripts/run-worker.ts",
    "checkouts:expire": "node --conditions=react-server --import tsx scripts/expire-checkouts.ts",
    "prestart": "npm run preflight",
    "operations:check": "node --conditions=react-server --import tsx scripts/check-operations.ts",
    "adm:preview:seed": "node --conditions=react-server --import tsx scripts/adm-preview.ts seed",
    "adm:preview": "node --conditions=react-server --import tsx scripts/adm-preview.ts start",
    "adm:preview:info": "node --conditions=react-server --import tsx scripts/adm-preview.ts info",
    "adm:preview:clean": "node --conditions=react-server --import tsx scripts/adm-preview.ts clean",
    "adm:preview:verify": "node --conditions=react-server --import tsx scripts/adm-preview.ts verify",
    "adm:preview:test": "playwright test --config playwright.adm.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^17.4.2",
    "next": "16.4.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "^0.35.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "deepmerge-ts": "8.0.1",
    "mysql2": "3.23.1"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": "eslint"
  }
}
