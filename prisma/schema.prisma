generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GroupBuyStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum OrderStatus {
  PLACED
  CANCELLED
}

enum FulfillmentMethod {
  SELF_PICKUP
  SEVEN_ELEVEN
}

enum ShipmentProvider {
  SEVEN_ELEVEN_MYSHIP
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  email        String  @unique
  passwordHash String
  isActive     Boolean @default(true)

  sessions                    Session[]
  inventoryMovements InventoryMovement[]
  pendingGroupBuyImageUploads PendingGroupBuyImageUpload[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
}

model Supplier {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  contactName String?
  phone       String?
  lineContact String?
  note        String?
  isActive    Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Product {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String?
  imageUrl    String?

  defaultPrice Int
  cost         Int
  unit         String

  supplierId String?   @db.Uuid
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  isActive Boolean @default(true)

  skuInventoryEnabled Boolean @default(false)

  groupBuyItems GroupBuyItem[]
  skus          ProductSku[]
  options       ProductOption[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([supplierId])
}

// SKU identity is stable. New offers and shared stock coexist with isolated legacy items.
model ProductSku {
  id             String  @id @default(uuid()) @db.Uuid
  productId      String  @db.Uuid
  code           String  @unique @db.VarChar(64)
  combinationKey String  @db.VarChar(1024)
  isActive       Boolean @default(true)
  displayName    String? @db.VarChar(160)
  temperature    String @default("AMBIENT") @db.VarChar(16)
  shippingMethods String[] @default([])
  weightGrams    Int?
  lengthMm       Int?
  widthMm        Int?
  heightMm       Int?
  shippingNote   String? @db.VarChar(500)

  product Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  options ProductSkuOptionValue[]
  offers GroupBuySku[]
  inventory SkuInventory?
  movements InventoryMovement[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  // Deferred SQL triggers verify this key against the actual selected values.
  @@unique([productId, combinationKey])
  @@unique([id, productId])
}

model ProductOption {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  name      String @db.VarChar(80)

  product Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  values  ProductOptionValue[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([productId, name])
  @@unique([id, productId])
}

model ProductOptionValue {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  optionId  String @db.Uuid
  value     String @db.VarChar(80)

  option ProductOption           @relation(fields: [optionId, productId], references: [id, productId], onDelete: Restrict)
  skus   ProductSkuOptionValue[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([optionId, value])
  @@unique([id, optionId, productId])
}

model ProductSkuOptionValue {
  skuId         String @db.Uuid
  productId     String @db.Uuid
  optionId      String @db.Uuid
  optionValueId String @db.Uuid

  sku         ProductSku         @relation(fields: [skuId, productId], references: [id, productId], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId, optionId, productId], references: [id, optionId, productId], onDelete: Restrict)

  // At most one selected value per dimension, with same-product composite FKs.
  @@id([skuId, optionId])
  @@index([skuId, productId])
  @@index([optionValueId, optionId, productId])
}

model PickupLocation {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  address     String
  description String?
  isActive    Boolean @default(true)

  groupBuyPickups GroupBuyPickup[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model GroupBuy {
  id          String         @id @default(uuid()) @db.Uuid
  title       String
  slug        String         @unique
  description String?
  status      GroupBuyStatus @default(DRAFT)

  startAt DateTime @db.Timestamptz(3)
  endAt   DateTime @db.Timestamptz(3)

  publishedAt DateTime? @db.Timestamptz(3)
  isArchived Boolean @default(false)
  isFeatured Boolean @default(false)
  featuredSort Int @default(0)
  allowsCombinedShipping Boolean @default(true)
  categoryId String? @db.Uuid
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  skuOffers GroupBuySku[]

  allowsSelfPickup  Boolean @default(true)
  allowsSevenEleven Boolean @default(false)

  items                      GroupBuyItem[]
  images                     GroupBuyImage[]
  pickups                    GroupBuyPickup[]
  orders                     Order[]
  sevenElevenStoreSelections SevenElevenStoreSelection[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([status, startAt])
  @@index([status, endAt])
}

model Category {
  id String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(80)
  sortOrder Int @default(0)
  isActive Boolean @default(true)
  groupBuys GroupBuy[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model GroupBuySku {
  id String @id @default(uuid()) @db.Uuid
  groupBuyId String @db.Uuid
  skuId String @db.Uuid
  salePrice Int
  purchaseLimit Int?
  isActive Boolean @default(true)
  groupBuy GroupBuy @relation(fields: [groupBuyId], references: [id], onDelete: Restrict)
  sku ProductSku @relation(fields: [skuId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@unique([groupBuyId, skuId])
  @@index([skuId])
}

// Absence means unverified; never infer onHand from legacy GroupBuyItem.stock.
model SkuInventory {
  skuId String @id @db.Uuid
  onHand Int
  reserved Int @default(0)
  allocated Int @default(0)
  version Int @default(1)
  sku ProductSku @relation(fields: [skuId], references: [id], onDelete: Restrict)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model InventoryMovement {
  id String @id @default(uuid()) @db.Uuid
  requestId String @unique @db.Uuid
  skuId String @db.Uuid
  actorId String @db.Uuid
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  kind String @db.VarChar(16)
  beforeOnHand Int
  afterOnHand Int
  reserved Int
  allocated Int
  reason String @db.VarChar(500)
  sku ProductSku @relation(fields: [skuId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([skuId, createdAt])
}

model GroupBuyImage {
  id         String @id @default(uuid()) @db.Uuid
  groupBuyId String @db.Uuid

  imageUrl   String
  storageKey String? @unique
  sortOrder  Int

  groupBuy GroupBuy @relation(fields: [groupBuyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([groupBuyId, sortOrder])
}

model PendingGroupBuyImageUpload {
  id          String @id @default(uuid()) @db.Uuid
  adminUserId String @db.Uuid

  storageKey String    @unique
  imageUrl   String
  byteSize   Int
  mimeType   String
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)

  adminUser User @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([adminUserId, expiresAt])
  @@index([expiresAt, consumedAt])
}

model GroupBuyItem {
  id String @id @default(uuid()) @db.Uuid

  groupBuyId String @db.Uuid
  productId  String @db.Uuid

  groupBuy GroupBuy @relation(fields: [groupBuyId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  orderItems OrderItem[]

  salePrice Int
  cost      Int

  stock         Int?
  purchaseLimit Int?

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([groupBuyId, productId])
  @@index([productId])
}

model GroupBuyPickup {
  id String @id @default(uuid()) @db.Uuid

  groupBuyId       String @db.Uuid
  pickupLocationId String @db.Uuid

  groupBuy       GroupBuy       @relation(fields: [groupBuyId], references: [id], onDelete: Cascade)
  pickupLocation PickupLocation @relation(fields: [pickupLocationId], references: [id], onDelete: Restrict)

  orders Order[]

  pickupStartAt DateTime? @db.Timestamptz(3)
  pickupEndAt   DateTime? @db.Timestamptz(3)

  sortOrder Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([groupBuyId, pickupLocationId])
  @@index([pickupLocationId])
}

model Customer {
  id    String @id @default(uuid()) @db.Uuid
  phone String @unique

  orders Order[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model CustomerAccount {
  id          String   @id @default(uuid()) @db.Uuid
  lineUserId  String   @unique
  displayName String?
  pictureUrl  String?
  lastLoginAt DateTime @db.Timestamptz(3)

  sessions CustomerSession[]
  orders   Order[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model CustomerSession {
  id                String   @id @default(uuid()) @db.Uuid
  customerAccountId String   @db.Uuid
  tokenHash         String   @unique
  expiresAt         DateTime @db.Timestamptz(3)

  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([customerAccountId])
  @@index([expiresAt])
}

model Order {
  id              String  @id @default(uuid()) @db.Uuid
  publicCode      String  @unique
  orderNumber     String  @unique
  accessTokenHash String? @unique

  groupBuyId        String  @db.Uuid
  customerId        String  @db.Uuid
  customerAccountId String? @db.Uuid
  groupBuyPickupId  String? @db.Uuid

  status            OrderStatus
  fulfillmentMethod FulfillmentMethod @default(SELF_PICKUP)
  shipmentRequired  Boolean           @default(false)

  customerName  String
  customerPhone String

  pickupName    String?
  pickupAddress String?
  pickupStartAt DateTime? @db.Timestamptz(3)
  pickupEndAt   DateTime? @db.Timestamptz(3)

  sevenElevenStoreId      String?
  sevenElevenStoreName    String?
  sevenElevenStoreAddress String?

  totalAmount Int

  groupBuy                  GroupBuy                   @relation(fields: [groupBuyId], references: [id], onDelete: Restrict)
  customer                  Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerAccount           CustomerAccount?           @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)
  groupBuyPickup            GroupBuyPickup?            @relation(fields: [groupBuyPickupId], references: [id], onDelete: Restrict)
  sevenElevenStoreSelection SevenElevenStoreSelection?

  items     OrderItem[]
  shipments Shipment[]

  cancelledAt DateTime? @db.Timestamptz(3)
  pickedUpAt  DateTime? @db.Timestamptz(3)
  paidAt      DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([groupBuyId, createdAt])
  @@index([customerId, groupBuyId, status])
  @@index([customerAccountId, createdAt])
  @@index([groupBuyPickupId])
  @@index([createdAt, id])
}

model OrderNumberSequence {
  dateKey   String @id @db.VarChar(8)
  lastValue Int
}

model Shipment {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid

  provider       ShipmentProvider
  trackingNumber String           @db.VarChar(128)

  recipientName           String
  recipientPhone          String
  sevenElevenStoreId      String
  sevenElevenStoreName    String
  sevenElevenStoreAddress String

  shippedAt  DateTime? @db.Timestamptz(3)
  arrivedAt  DateTime? @db.Timestamptz(3)
  returnedAt DateTime? @db.Timestamptz(3)
  voidedAt   DateTime? @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([provider, trackingNumber])
  @@index([orderId, createdAt])
}

model SevenElevenStoreSelection {
  id String @id @default(uuid()) @db.Uuid

  stateHash          String  @unique
  merchantTradeNo    String  @unique
  selectionTokenHash String? @unique
  browserBindingHash String

  groupBuyId String  @db.Uuid
  orderId    String? @unique @db.Uuid

  storeId      String?
  storeName    String?
  storeAddress String?

  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  groupBuy GroupBuy @relation(fields: [groupBuyId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([groupBuyId, expiresAt])
  @@index([expiresAt])
}

model OrderItem {
  id String @id @default(uuid()) @db.Uuid

  orderId        String @db.Uuid
  groupBuyItemId String @db.Uuid

  productName String
  unit        String
  unitPrice   Int
  quantity    Int

  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  groupBuyItem GroupBuyItem @relation(fields: [groupBuyItemId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([orderId, groupBuyItemId])
  @@index([groupBuyItemId, orderId])
}
