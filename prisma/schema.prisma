generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GroupBuyStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum OrderStatus {
  PLACED
  CANCELLED
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  email        String  @unique
  passwordHash String
  isActive     Boolean @default(true)

  sessions Session[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
}

model Supplier {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  contactName String?
  phone       String?
  lineContact String?
  note        String?
  isActive    Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Product {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String?
  imageUrl    String?

  defaultPrice Int
  cost         Int
  unit         String

  supplierId String?   @db.Uuid
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  isActive Boolean @default(true)

  groupBuyItems GroupBuyItem[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([supplierId])
}

model PickupLocation {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  address     String
  description String?
  isActive    Boolean @default(true)

  groupBuyPickups GroupBuyPickup[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model GroupBuy {
  id            String  @id @default(uuid()) @db.Uuid
  title         String
  slug          String  @unique
  description   String?
  coverImageUrl String?

  status GroupBuyStatus @default(DRAFT)

  startAt DateTime @db.Timestamptz(3)
  endAt   DateTime @db.Timestamptz(3)

  publishedAt DateTime? @db.Timestamptz(3)

  items   GroupBuyItem[]
  pickups GroupBuyPickup[]
  orders  Order[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([status, startAt])
  @@index([status, endAt])
}

model GroupBuyItem {
  id String @id @default(uuid()) @db.Uuid

  groupBuyId String @db.Uuid
  productId  String @db.Uuid

  groupBuy GroupBuy @relation(fields: [groupBuyId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  orderItems OrderItem[]

  salePrice Int
  cost      Int

  stock         Int?
  purchaseLimit Int?

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([groupBuyId, productId])
  @@index([productId])
}

model GroupBuyPickup {
  id String @id @default(uuid()) @db.Uuid

  groupBuyId       String @db.Uuid
  pickupLocationId String @db.Uuid

  groupBuy       GroupBuy       @relation(fields: [groupBuyId], references: [id], onDelete: Cascade)
  pickupLocation PickupLocation @relation(fields: [pickupLocationId], references: [id], onDelete: Restrict)

  orders Order[]

  pickupStartAt DateTime? @db.Timestamptz(3)
  pickupEndAt   DateTime? @db.Timestamptz(3)

  sortOrder Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([groupBuyId, pickupLocationId])
  @@index([pickupLocationId])
}

model Customer {
  id    String @id @default(uuid()) @db.Uuid
  phone String @unique

  orders Order[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model Order {
  id              String  @id @default(uuid()) @db.Uuid
  publicCode      String  @unique
  accessTokenHash String? @unique

  groupBuyId       String @db.Uuid
  customerId       String @db.Uuid
  groupBuyPickupId String @db.Uuid

  status OrderStatus

  customerName  String
  customerPhone String

  pickupName      String
  pickupAddress   String
  pickupStartAt   DateTime? @db.Timestamptz(3)
  pickupEndAt     DateTime? @db.Timestamptz(3)

  totalAmount Int

  groupBuy       GroupBuy       @relation(fields: [groupBuyId], references: [id], onDelete: Restrict)
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  groupBuyPickup GroupBuyPickup @relation(fields: [groupBuyPickupId], references: [id], onDelete: Restrict)

  items OrderItem[]

  cancelledAt DateTime? @db.Timestamptz(3)
  pickedUpAt  DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([groupBuyId, createdAt])
  @@index([customerId, groupBuyId, status])
  @@index([groupBuyPickupId])
}

model OrderItem {
  id String @id @default(uuid()) @db.Uuid

  orderId        String @db.Uuid
  groupBuyItemId String @db.Uuid

  productName String
  unit        String
  unitPrice   Int
  quantity    Int

  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  groupBuyItem GroupBuyItem @relation(fields: [groupBuyItemId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([orderId, groupBuyItemId])
  @@index([groupBuyItemId, orderId])
}
